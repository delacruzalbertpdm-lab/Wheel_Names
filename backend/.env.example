# Django Core Settings
SECRET_KEY=django-insecure-pulsedraw-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Local development defaults to SQLite when DATABASE_URL is omitted or set to sqlite:///db.sqlite3
# For Supabase or PostgreSQL migration in production, set:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=600

# CORS Settings (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

